{
  "name": "react-native-template-project",
  "main": "App.tsx",
  "version": "1.0.0",
  "description": "A comprehensive React Native template project with atomic design, Redux Toolkit, and i18n support",
  "author": "Your Name",
  "private": true,
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:src": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json}'",
    "lint:format": "npm run lint && npm run format",
    "type-check": "tsc --noEmit",
    "clean": "expo r -c",
    "prebuild": "expo prebuild",
    "build:android": "expo build:android",
    "build:ios": "expo build:ios",
    "eject": "expo eject"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.2.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/drawer": "^7.3.9",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/stack": "^7.4.7",
    "@reduxjs/toolkit": "^2.8.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "expo": "~54.0.0",
    "expo-blur": "~15.0.0",
    "expo-constants": "~18.0.0",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.0",
    "expo-image": "~2.6.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-splash-screen": "~0.31.0",
    "expo-status-bar": "~2.3.0",
    "expo-symbols": "~0.5.0",
    "expo-system-ui": "~6.0.0",
    "expo-web-browser": "~15.0.0",
    "i18n-js": "^4.5.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-elements": "^3.4.3",
    "react-native-gesture-handler": "~2.26.0",
    "react-native-reanimated": "~3.21.0",
    "react-native-safe-area-context": "5.5.0",
    "react-native-screens": "~4.15.0",
    "react-native-svg": "16.4.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.20.0",
    "react-native-webview": "14.0.1",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/typescript-config": "^0.81.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "@types/react-test-renderer": "^18.0.7",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "keywords": [
    "react-native",
    "expo",
    "template",
    "typescript",
    "redux",
    "atomic-design",
    "i18n",
    "navigation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/react-native-template-project.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/react-native-template-project/issues"
  },
  "homepage": "https://github.com/your-username/react-native-template-project#readme"
}